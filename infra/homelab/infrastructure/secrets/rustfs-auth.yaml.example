# bash infra/homelab/scripts/seal-secret.sh rustfs rustfs-secret \
#   RUSTFS_ACCESS_KEY=<admin-access-key> \
#   RUSTFS_SECRET_KEY=<admin-secret-key-min-8-chars> \
#   > infra/homelab/infrastructure/secrets/rustfs-auth.yaml
#
# After generating rustfs-auth.yaml, add it to kustomization.yaml's resources list.
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: rustfs-secret
  namespace: rustfs
spec:
  encryptedData:
    RUSTFS_ACCESS_KEY: <encrypted>
    RUSTFS_SECRET_KEY: <encrypted>
