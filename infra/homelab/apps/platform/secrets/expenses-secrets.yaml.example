# DATABASE_URL format: postgresql://expense-svc:<password>@postgres.postgres.svc.cluster.local:5432/platform
# <password> must match the role created in apps/postgres/init.sql (CREATE ROLE "expense-svc").
#
# minio is decommissioned — object storage is rustfs, so MINIO_ACCESS_KEY/MINIO_SECRET_KEY
# (env var names come from the expenses-service chart, unchanged) must hold the same
# RUSTFS_ACCESS_KEY/RUSTFS_SECRET_KEY values sealed into infrastructure/secrets/rustfs-auth.yaml.
#
# bash infra/homelab/scripts/seal-secret.sh platform expenses-secrets \
#   DATABASE_URL='postgresql://expense-svc:<password>@postgres.postgres.svc.cluster.local:5432/platform' \
#   MINIO_ACCESS_KEY=<same-value-as-rustfs-RUSTFS_ACCESS_KEY> \
#   MINIO_SECRET_KEY=<same-value-as-rustfs-RUSTFS_SECRET_KEY> \
#   > infra/homelab/infrastructure/secrets/expenses-secrets.yaml
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: expenses-secrets
  namespace: platform
spec:
  encryptedData:
    DATABASE_URL: <encrypted>
    MINIO_ACCESS_KEY: <encrypted>
    MINIO_SECRET_KEY: <encrypted>
